{
	"name": "@aarock1234/slopscan",
	"version": "0.4.1",
	"description": "scores a git diff for slop: hacky, non-idiomatic, non-future-proof code",
	"keywords": [
		"code-review",
		"lint",
		"typescript",
		"go",
		"ast-grep",
		"llm",
		"github-action"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aarock1234/slopscan.git"
	},
	"homepage": "https://github.com/aarock1234/slopscan#readme",
	"bugs": "https://github.com/aarock1234/slopscan/issues",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.4.1",
	"bin": {
		"slopscan": "dist/cli.js"
	},
	"files": [
		"dist",
		"rules",
		"prompts",
		"SKILL.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env --import tsx src/cli.ts",
		"build": "tsc -p tsconfig.build.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"check": "concurrently \"pnpm typecheck\" \"pnpm lint\" \"pnpm format:check\" \"pnpm test\"",
		"script": "node --env-file-if-exists=.env --import tsx",
		"clean": "rm -rf dist coverage *.tsbuildinfo",
		"prepublishOnly": "pnpm check && pnpm build"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.71",
		"@ast-grep/lang-go": "^0.0.6",
		"@ast-grep/napi": "^0.45.3",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"@typesafe-ai/sdk": "^0.6.0",
		"ai": "^7.0.107",
		"gray-matter": "^4.0.3",
		"p-limit": "^7.3.3",
		"picocolors": "^1.1.1",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"yaml": "^2.9.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.2",
		"concurrently": "^10.0.5",
		"eslint": "^10.11.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.8",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.1"
	}
}
